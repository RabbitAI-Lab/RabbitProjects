worker_processes auto;
events { worker_connections 4096; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    limit_req_zone $binary_remote_addr zone=api_zone:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=5r/s;

    include /etc/nginx/snippets/upstreams.conf;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;
        server_name ${SERVER_NAME};

        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'ok';
        }

        location ^~ /api/v1/auth/ {
            limit_req zone=auth_zone burst=10 nodelay;
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # COLLAB-004 §4.2（api-conventions.md §9.7 第二道防线）：服务间内部端点
        # （live→api verify-rooms 复核）不面向用户流量——proxy 不路由该前缀，
        # 仅 compose 内网可达；^~ 最长前缀匹配优先于下方 /api/。
        location ^~ /api/v1/internal/ { return 404; }

        location ^~ /api/ {
            limit_req zone=api_zone burst=60 nodelay;
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location ^~ /django-admin/ { proxy_pass http://api_upstream; include /etc/nginx/snippets/common.conf; }
        location ^~ /static/       { proxy_pass http://api_upstream; include /etc/nginx/snippets/common.conf; }

        location ^~ /live/ {
            proxy_pass http://live_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # COLLAB-004 BR-04 心跳窗口：服务端 25s ping / 60s pong 容忍——读超时
            # 须 ≥75s 才不会在两跳心跳间掐断长连接；3600s 覆盖（P3 Hocuspocus 同宿主复用）。
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # FILE-001 §4.7 / AUTH-004 §4.2.2：对象存储直传（附件 / 头像）。
        # presign 返回的是同源 /uploads/<bucket>/<key>?X-Amz-…，
        # 缺这段会落到 `location /` 被 web_upstream 吃掉 → 上传静默失败。
        # Host 必须透传上游主机名：SigV4 把 host 纳入签名，改写成 $host 会 403。
        location ^~ /uploads/ {
            client_max_body_size ${CLIENT_MAX_BODY_SIZE};
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass http://minio_upstream/;
            proxy_redirect off;
            proxy_buffering off;
            proxy_request_buffering off;
        }

        location ^~ /god-mode { proxy_pass http://admin_upstream; include /etc/nginx/snippets/common.conf; }
        location ^~ /spaces   { proxy_pass http://space_upstream; include /etc/nginx/snippets/common.conf; }
        location /            { proxy_pass http://web_upstream; include /etc/nginx/snippets/common.conf; }
    }
}
