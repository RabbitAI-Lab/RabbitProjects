{
  "name": "rabbit-projects",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev dev:watch --filter=@rp/web... --filter=@rp/live...",
    "dev:all": "turbo run dev dev:watch",
    "dev:admin": "turbo run dev --filter=@rp/admin...",
    "dev:space": "turbo run dev --filter=@rp/space...",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "ci:affected": "turbo run lint typecheck test build --filter=...[origin/main]",
    "api:lint": "uv run --project apps/api ruff check .",
    "api:typecheck": "uv run --project apps/api mypy plane",
    "api:test": "uv run --project apps/api pytest",
    "api:migrate": "uv run --project apps/api python manage.py migrate",
    "gen:api-types": "node scripts/gen-api-types.mjs",
    "check:yjs": "node scripts/check-yjs-version.mjs",
    "compose:up": "docker compose --env-file .env -f deploy/compose/docker-compose.yml up -d",
    "compose:down": "docker compose --env-file .env -f deploy/compose/docker-compose.yml down",
    "compose:logs": "docker compose --env-file .env -f deploy/compose/docker-compose.yml logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "19.x",
    "@commitlint/config-conventional": "19.x",
    "@playwright/test": "1.54.x",
    "husky": "9.1.x",
    "lint-staged": "15.x",
    "oxfmt": "0.x",
    "oxlint": "1.x",
    "turbo": "2.5.x",
    "typescript": "5.8.x",
    "vitest": "3.x"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,css}": [
      "oxfmt"
    ],
    "apps/api/**/*.py": [
      "uv run --project apps/api ruff check --fix",
      "uv run --project apps/api ruff format"
    ]
  },
  "engines": {
    "node": ">=22.14 <23",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.0.0"
}
