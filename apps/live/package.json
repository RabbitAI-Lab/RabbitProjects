{
  "name": "@rp/live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsup src/index.ts --watch --dts --format esm --onSuccess \"node dist/index.js\"",
    "build": "tsup src/index.ts --dts --format esm",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hocuspocus/server": "2.15.x",
    "@rp/editor": "workspace:*",
    "@rp/types": "workspace:*",
    "express": "4.21.x",
    "y-prosemirror": "1.3.x",
    "y-protocols": "1.0.x",
    "yjs": "13.6.x",
    "zod": "3.25.x"
  },
  "devDependencies": {
    "@types/express": "4.17.x",
    "@types/node": "22.x",
    "oxlint": "1.x",
    "tsup": "8.x",
    "typescript": "5.8.x",
    "vitest": "3.x"
  }
}
