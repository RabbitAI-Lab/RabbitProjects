worker_processes auto;
events { worker_connections 4096; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # ── L1 边缘限流（INFRA-005 §4.3.1——收编 INFRA-002 §4.4 P0 两行 zone）──
    # geo→map 白名单：内网监控源得空键；nginx 官方语义「空键值的请求不计数」
    # ——map 产物 $rp_limit_key 必须接进每一个 limit_req_zone（不接线则白名单失效）
    geo $rp_internal {
        default        0;
        10.0.0.0/8     1;
        172.16.0.0/12  1;
        192.168.0.0/16 1;
    }
    map $rp_internal $rp_limit_key {
        0    $binary_remote_addr;
        1    "";                        # 空键 = 不限流（BR-05 内网监控豁免）
    }

    # 三区：zone 名沿用基线命名，数值 = api-conventions §7 冻结值
    #（api 300r/min=5r/s、auth 10r/m、public 30r/m；auth/public 为 L2 同值的
    # 边缘预拦——同值双层，L1 挡扫描爆破、L2 兜业务公平）
    limit_req_zone $rp_limit_key zone=api_zone:10m    rate=5r/s;
    limit_req_zone $rp_limit_key zone=auth_zone:2m    rate=10r/m;
    limit_req_zone $rp_limit_key zone=public_zone:4m  rate=30r/m;

    limit_req_status 429;
    limit_req_log_level warn;           # 429 计入日志（admin 概览数据源，BR-14）

    include /etc/nginx/snippets/upstreams.conf;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;
        server_name ${SERVER_NAME};

        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'ok';
        }

        # 健康检查（INFRA-002 §4.10 / BR-05）：不声明 limit_req 即不限流、
        # 不消耗配额；nginx 无 `limit_req off` 语法。proxy 自身 /healthz 在上方。
        location ^~ /api/v1/health/ {
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location ^~ /api/v1/auth/ {
            limit_req zone=auth_zone burst=5 nodelay;  # 突发 5 直拒（防爆破扫描）
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # 匿名公开面（FILE-004 分享 / 公共头像）：30r/m 边缘预拦
        location ^~ /api/v1/public/ {
            limit_req zone=public_zone burst=10 nodelay;
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        # COLLAB-004 §4.2（api-conventions.md §9.7 第二道防线）：服务间内部端点
        # （live→api verify-rooms 复核）不面向用户流量——proxy 不路由该前缀，
        # 仅 compose 内网可达；^~ 最长前缀匹配优先于下方 /api/。
        location ^~ /api/v1/internal/ { return 404; }

        location ^~ /api/ {
            limit_req zone=api_zone burst=60 nodelay;
            proxy_pass http://api_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location ^~ /django-admin/ { proxy_pass http://api_upstream; include /etc/nginx/snippets/common.conf; }
        location ^~ /static/       { proxy_pass http://api_upstream; include /etc/nginx/snippets/common.conf; }

        location ^~ /live/ {
            proxy_pass http://live_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # COLLAB-004 BR-04 心跳窗口：服务端 25s ping / 60s pong 容忍——读超时
            # 须 ≥75s 才不会在两跳心跳间掐断长连接；3600s 覆盖（P3 Hocuspocus 同宿主复用）。
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # FILE-001 §4.7 / AUTH-004 §4.2.2：对象存储直传（附件 / 头像）。
        # presign 返回的是同源 /uploads/<bucket>/<key>?X-Amz-…，
        # 缺这段会落到 `location /` 被 web_upstream 吃掉 → 上传静默失败。
        # Host 必须透传上游主机名：SigV4 把 host 纳入签名，改写成 $host 会 403。
        # FILE-002 §1.7 第 5 行：直传上限独立于全局 CLIENT_MAX_BODY_SIZE——
        # 文件库 50MB 直传 + 头部/签名余量 → 60m 缺省（规格「30m→60m」的参数化落地；
        # 独立 UPLOADS_MAX_BODY_SIZE 可向上调，其余指令维持）。
        location ^~ /uploads/ {
            client_max_body_size ${UPLOADS_MAX_BODY_SIZE};
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass http://minio_upstream/;
            proxy_redirect off;
            proxy_buffering off;
            proxy_request_buffering off;
        }

        location ^~ /god-mode { proxy_pass http://admin_upstream; include /etc/nginx/snippets/common.conf; }
        location ^~ /spaces   { proxy_pass http://space_upstream; include /etc/nginx/snippets/common.conf; }
        location /            { proxy_pass http://web_upstream; include /etc/nginx/snippets/common.conf; }

        # ── L1 网关 429（INFRA-005 BR-06，对齐 INFRA-004 §4.10 网关错误体）──
        # 无 request_id；不附 X-RateLimit-*（nginx limit_req 无每主体剩余数可
        # 暴露，不伪造数值）；Retry-After 静态兜底（精确秒数由 L2/L3 应用层提供）
        error_page 429 = @rate_limited;
        location @rate_limited {
            default_type application/json;
            add_header Retry-After 60 always;
            return 429 '{"status":"error","error":{"code":"RATE_LIMIT_EXCEEDED","message":"请求过于频繁，请稍后重试"}}';
        }
    }
}
